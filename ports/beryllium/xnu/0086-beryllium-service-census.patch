--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -25,6 +25,48 @@
 extern void sweet_sample_start(void);
 
 static char sweet_sample_names[128];
+
+/* Poco diagnostics: report absence explicitly before any stack walk. */
+static struct {
+    const char *name;
+    unsigned count;
+    int first_pid;
+} beryllium_watch[] = {
+    { "launchd", 0, 0 }, { "seputil", 0, 0 }, { "keybagd", 0, 0 },
+    { "lsd", 0, 0 }, { "cfprefsd", 0, 0 }, { "installd", 0, 0 },
+    { "SpringBoard", 0, 0 }, { "backboardd", 0, 0 },
+};
+
+static int
+beryllium_census_proc(proc_t p, __unused void *arg)
+{
+    char name[32];
+    proc_name(proc_pid(p), name, sizeof(name));
+    for (unsigned i = 0; i < sizeof(beryllium_watch) / sizeof(beryllium_watch[0]); i++) {
+        if (strcmp(name, beryllium_watch[i].name) == 0) {
+            if (beryllium_watch[i].count++ == 0) {
+                beryllium_watch[i].first_pid = proc_pid(p);
+            }
+        }
+    }
+    return PROC_RETURNED;
+}
+
+static void
+beryllium_census(void)
+{
+    for (unsigned i = 0; i < sizeof(beryllium_watch) / sizeof(beryllium_watch[0]); i++) {
+        beryllium_watch[i].count = 0;
+        beryllium_watch[i].first_pid = 0;
+    }
+    proc_iterate(PROC_ALLPROCLIST, beryllium_census_proc, NULL, NULL, NULL);
+    for (unsigned i = 0; i < sizeof(beryllium_watch) / sizeof(beryllium_watch[0]); i++) {
+        printf("BERYLLIUM census: %s count=%u first_pid=%d\n",
+            beryllium_watch[i].name, beryllium_watch[i].count,
+            beryllium_watch[i].first_pid);
+    }
+}
+
 
 static bool
 sweet_sample_wanted(const char *name)
